# Baton production environment: ~/.config/baton/baton.env (mode 600) on the host.
#
# scripts/install-mini.sh creates the real file from this template once, filling in DATA_DIR and a
# random BETTER_AUTH_SECRET, and never overwrites it afterwards. Edit the real file, then run
# `systemctl --user restart baton`. Every variable is documented in .env.example at the repo root.
#
# The file is read by systemd (EnvironmentFile=) and by `node --env-file` (scripts/deploy.sh runs
# the migrations with it), so keep to plain KEY=value lines: no `export`, no shell expansion, and
# double quotes around values containing spaces or < >. Empty values count as unset.
#
# NODE_ENV=production and HOST=127.0.0.1 are set by deploy/baton.service; a value here would
# override them, so leave them out. Baton must only listen on loopback: the public entry point is
# the Cloudflare Tunnel.

# Loopback port the service listens on. The tunnel (~/.cloudflared/config.yml) points here.
PORT=3000

# Public origin users open in the browser, without a trailing slash. Used for CSRF origin checks,
# OAuth callbacks, email links and the URLs MCP returns. Before the tunnel exists this is the
# ssh-forwarded loopback address; scripts/cloudflare-tunnel.sh sets it to https://<hostname>.
BASE_URL=http://localhost:3000

# SQLite database, uploads/ and backups/. Absolute path; install-mini.sh fills it in.
DATA_DIR=__DATA_DIR__

# Session signing secret (>= 32 chars). install-mini.sh generates one with `openssl rand -hex 32`.
# Changing it signs everyone out.
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__

# none | cloudflare. cloudflare-tunnel.sh switches this to cloudflare, so rate limits and the
# security log use the real client IP from CF-Connecting-IP. Only use cloudflare while the port
# is reachable solely through the tunnel (HOST=127.0.0.1), or clients could spoof their IP.
TRUST_PROXY=none

# Outgoing email for verification and password-reset codes, e.g.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
# URL-encode special characters in the password. While unset, codes are only written to the log
# (journalctl --user -u baton), and nobody else can finish signing up.
SMTP_URL=
MAIL_FROM="Baton <baton@localhost>"

# Social sign-in: a provider is enabled only when both its id and secret are set. Register these
# callback URLs with the provider (BASE_URL must be the public https origin first):
#   Google: <BASE_URL>/api/auth/callback/google
#   GitHub: <BASE_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Repository READMEs (a project's overview can show a file or folder of a GitHub repo): a GitHub
# App whose client id/secret are GITHUB_CLIENT_ID/SECRET above (the same app signs people in).
# App settings: callback URLs $BASE_URL/api/auth/callback/github and $BASE_URL/api/github/verify,
# setup URL $BASE_URL/api/github/setup, permissions Contents: read-only and Metadata: read-only.
# The private key is the downloaded .pem (newlines may be written as \n). Set all three or none.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# Open sign-ups (teams stay invite-only either way). true | false
SIGNUPS_ENABLED=true

# Max size of one attachment and total attachment storage per team, in MB.
MAX_UPLOAD_MB=25
TEAM_STORAGE_QUOTA_MB=5120

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
