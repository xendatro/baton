# Baton configuration. Copy to .env for local development (`npm run dev` loads it automatically);
# production reads the same variables from ~/.config/baton/baton.env (see docs/DEPLOY.md).
# Empty values count as unset.

# development | production | test. Production requires BASE_URL and BETTER_AUTH_SECRET.
# `npm start` (the built server) defaults to production; `npm run dev` to development.
NODE_ENV=development

# HTTP listener. Keep HOST on loopback behind Cloudflare Tunnel.
PORT=3000
HOST=127.0.0.1

# Public origin users open in the browser, without a trailing slash. Used for CSRF origin checks,
# OAuth callbacks, email links and MCP entity URLs.
# Default: http://localhost:5173 in development (the Vite dev server), http://localhost:$PORT otherwise.
BASE_URL=http://localhost:5173

# Where the SQLite database (baton.db), uploads/ and backups/ live. Default ./data
DATA_DIR=./data

# Secret for signing sessions (>= 32 chars). Required in production, and whenever BASE_URL is not
# a localhost address. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Social sign-in. A provider is enabled only when both its id and secret are set.
# Callback URLs: $BASE_URL/api/auth/callback/google and $BASE_URL/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Outgoing email (verification and password-reset codes), e.g. smtps://user:pass@smtp.example.com:465
# When unset, emails are printed to the server log instead (with a startup warning).
SMTP_URL=
MAIL_FROM=Baton <baton@localhost>

# Allow new account sign-ups (teams stay invite-only either way). true | false. Default true
SIGNUPS_ENABLED=true

# Max size of one attachment, in MB. Default 25
MAX_UPLOAD_MB=25

# Total attachment storage per team, in MB. Default 5120
TEAM_STORAGE_QUOTA_MB=5120

# none | cloudflare. With cloudflare, client IPs (rate limits, security log) come from CF-Connecting-IP.
TRUST_PROXY=none

# fatal | error | warn | info | debug | trace | silent. Default info (silent under NODE_ENV=test)
LOG_LEVEL=info
